      "codigo": "function calcular(datos) {\n  var dia = function (iso) { return new Date(Date.parse(iso) - 5 * 3600 * 1000).toISOString().slice(0, 10); };\n  var esConfirmado = function (e) { return e === 'confirmado' || e === 'enviado' || e === 'entregado' || e === 'novedad'; };\n  var N = 7;\n  var pedidos = (datos && Array.isArray(datos.pedidos)) ? datos.pedidos : [];\n  var conteo = {};\n  for (var i = 0; i < pedidos.length; i++) {\n    var p = pedidos[i];\n    if (!p || !esConfirmado(p.estado) || !p.creado) continue;\n    var d = dia(p.creado);\n    conteo[d] = (conteo[d] || 0) + 1;\n  }\n  var serie = [];\n  var total = 0;\n  for (var n = N - 1; n >= 0; n--) {\n    var iso = new Date(Date.parse(datos.hoy) - n * 86400000).toISOString();\n    var etiqueta = dia(iso);\n    var v = conteo[etiqueta] || 0;\n    serie.push({ etiqueta: etiqueta, valor: v });\n    total += v;\n  }\n  return {\n    valor: total,\n    unidad: 'pedidos',\n    serie: serie,\n    nota: 'Cuenta pedidos confirmados (confirmado, enviado, entregado y novedad) por dia de creacion en Bogota en los ultimos 7 dias.'\n  };\n}",
