      "codigo": "function formatearBogota(iso) {\n  if (!iso) return null;\n  var t = Date.parse(iso);\n  if (isNaN(t)) return String(iso);\n  return new Date(t - 5 * 3600 * 1000).toISOString().slice(0, 16).replace(\"T\", \" \");\n}\nfunction nombreCliente(datos, clienteId) {\n  var lista = datos.clientes || [];\n  for (var i = 0; i < lista.length; i++) {\n    if (lista[i].id === clienteId) return lista[i].nombre || \"Sin nombre\";\n  }\n  return \"Cliente no registrado\";\n}\nfunction detalleItems(pedido) {\n  var items = pedido.items || [];\n  var partes = [];\n  for (var i = 0; i < items.length; i++) {\n    var it = items[i];\n    partes.push(it.cantidad + \"x \" + it.nombre);\n  }\n  return partes.join(\"; \");\n}\nfunction consultar(datos) {\n  var pedidos = datos.pedidos || [];\n  var filtrados = [];\n  for (var i = 0; i < pedidos.length; i++) {\n    if (pedidos[i].estado === \"novedad\") filtrados.push(pedidos[i]);\n  }\n  filtrados.sort(function (a, b) { return Date.parse(b.creado) - Date.parse(a.creado); });\n  var filas = [];\n  var limite = filtrados.length > 200 ? 200 : filtrados.length;\n  for (var j = 0; j < limite; j++) {\n    var p = filtrados[j];\n    filas.push({\n      numero_pedido: p.numero,\n      cliente: nombreCliente(datos, p.clienteId),\n      ciudad: p.ciudad || \"\",\n      total: p.total,\n      fecha_creacion: formatearBogota(p.creado),\n      detalle_productos: detalleItems(p),\n      estado: p.estado\n    });\n  }\n  return filas;\n}",
